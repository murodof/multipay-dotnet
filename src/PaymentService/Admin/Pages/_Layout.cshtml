<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>@(ViewData["Title"] is string title ? $"{title} · " : "")Multipay Admin</title>
    <link rel="stylesheet" href="/admin/statics/tabler.min.css">
    <style>
        .brand-mark { width: 2rem; height: 2rem; border-radius: 8px; background: var(--tblr-primary); color: #fff; display: inline-flex; align-items: center; justify-content: center; font-weight: 700; }
        .nav-scroll { overflow-x: auto; flex-wrap: nowrap; }
        .nav-scroll .nav-link { white-space: nowrap; }
        .nav-scroll .nav-item.active .nav-link { color: var(--tblr-primary); box-shadow: inset 0 -2px 0 var(--tblr-primary); }
        .cell-id { font-family: var(--tblr-font-monospace); font-size: .8125rem; color: var(--tblr-secondary); }
        .cell-number { text-align: right; font-variant-numeric: tabular-nums; }
        .table thead th { white-space: nowrap; }
        .table td { white-space: nowrap; }
        .stat-value { font-size: 1.75rem; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
    </style>
</head>
<body>
@if (ViewData["Authenticated"] is true)
{
    <div class="page">
        <header class="navbar navbar-expand d-print-none">
            <div class="container-fluid px-3 px-md-4">
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="/admin/">
                    <span class="brand-mark">M</span>
                    <span>Multipay <span class="text-secondary fw-normal">Admin</span></span>
                </a>
                <div class="navbar-nav flex-row ms-auto">
                    <a class="btn btn-ghost-secondary" href="/admin/logout">Chiqish</a>
                </div>
            </div>
        </header>
        <header class="navbar navbar-expand d-print-none">
            <div class="container-fluid px-3 px-md-4">
                <ul class="navbar-nav nav-scroll w-100">
                    <li class="nav-item @(ViewData["Identity"] is null ? "active" : "")">
                        <a class="nav-link" href="/admin/">Umumiy ko‘rinish</a>
                    </li>
                    @foreach (var view in AdminViews.All)
                    {
                        <li class="nav-item @(ViewData["Identity"] as string == view.Identity ? "active" : "")">
                            <a class="nav-link" href="/admin/@view.Identity/list">@view.Label</a>
                        </li>
                    }
                </ul>
            </div>
        </header>
        <div class="page-wrapper">
            @RenderBody()
            <footer class="footer footer-transparent d-print-none">
                <div class="container-fluid px-3 px-md-4 text-secondary small">
                    Faqat o‘qish uchun · vaqtlar Toshkent vaqtida (UTC+05:00)
                </div>
            </footer>
        </div>
    </div>
}
else
{
    <div class="page page-center">
        @RenderBody()
    </div>
}
</body>
</html>
