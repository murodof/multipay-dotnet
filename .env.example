# ─── Required ───
# SQL Server connection string (ADO.NET format), not a URL.
DATABASE_URL=Server=localhost,1435;Database=payment;User Id=sa;Password=Payment_Passw0rd!;TrustServerCertificate=True;Encrypt=True
REDIS_URL=redis://localhost:6381/0
# Set production on deployment; a unique PAN_HASH_PEPPER is then required.
ENVIRONMENT=development

#   SECRET_KEYS=k2:<new-secret>,k1:<old-secret>@2026-09-16T12:00:00+05:00
SECRET_KEYS=k1:change-me-change-me-change-me-change-me

# ─── Framing (CSP frame-ancestors) ───
# Comma-separated https origins allowed to embed the checkout iframe. Empty = nobody.
ALLOWED_ORIGINS=https://operator.example.uz

# ─── Proxy ───
FORWARDED_ALLOW_IPS=127.0.0.1

# ─── Money (tiyin; defaults shown) ───
MIN_AMOUNT=100000
MAX_AMOUNT=100000000
COMMISSION_PERCENT=0

# ─── Windows (seconds; defaults shown) ───
# NONCE_TTL_SECONDS must be at least 2 * HASH_TS_WINDOW_SECONDS, or the app refuses to start.
HASH_TS_WINDOW_SECONDS=300
NONCE_TTL_SECONDS=900
SESSION_TTL_SECONDS=600
SESSION_IDLE_TIMEOUT_SECONDS=180
IDEMPOTENCY_TTL_SECONDS=600
OTP_TTL_SECONDS=59
OTP_LOCK_SECONDS=14400
PAN_HASH_PEPPER=replace-with-a-separate-random-production-secret

# ─── Uzcard SV-GATE ───
SVGATE_URL=https://svgate-sandbox.example.uz/
SVGATE_USERNAME=replace-me
SVGATE_PASSWORD=replace-me
SVGATE_TIMEOUT_SECONDS=25
SVGATE_TEMPLATE_ID=1
SVGATE_SERVICE_NAME=Multipay
SVGATE_MERCHANT_ID=replace-me
SVGATE_TERMINAL_ID=replace-me
SVGATE_MCC=4814
SVGATE_LEGAL_NAME=replace-me
SVGATE_LEGAL_TYPE=1
SVGATE_LEGAL_ID=replace-me
SVGATE_LEGAL_OKED=replace-me

# ─── Operator balance credit ───
OPERATOR_URL=https://operator.example.uz/api/top-up
OPERATOR_TOKEN=replace-me
OPERATOR_TIMEOUT_SECONDS=10

# ─── Rate limits (defaults shown) ───
RATE_LIMIT_IP_PER_MINUTE=10
RATE_LIMIT_IP_PER_HOUR=60
RATE_LIMIT_PHONE_PER_10_MINUTES=5

# ─── Misc (defaults shown) ───
HSTS_MAX_AGE_SECONDS=31536000

DOCS_ENABLED=false
ADMIN_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET_KEY=
ADMIN_COOKIE_SECURE=true
LOG_LEVEL=INFO

LOG_FILE=logs/payment.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

HUMO_ENABLED=false
HUMO_MW_URL=
HUMO_SMS_URL=
HUMO_BEARER_TOKEN=
HUMO_PS_URL=
HUMO_PS_USERNAME=
HUMO_PS_PASSWORD=
HUMO_MERCHANT_ID=
HUMO_TERMINAL_ID=
HUMO_CENTRE_ID=
HUMO_SERVICE_NAME=Multipay
# base64 of 32 random bytes, e.g. `openssl rand -base64 32`; AES-256-GCM key, separate from SECRET_KEYS.
HUMO_PAN_ENCRYPTION_KEY=
HUMO_BALANCE_PRECHECK=false
LOG_LEVEL=INFO
